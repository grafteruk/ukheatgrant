{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ukheatgrant",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "41834943055a4fc88c4f198891a9f0fc"
    }
  ]
}
